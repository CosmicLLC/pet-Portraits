// NextAuth.js (Auth.js v5) schema for Prisma + Postgres (Neon)
// Docs: https://authjs.dev/getting-started/adapters/prisma

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  emailVerified DateTime?
  image         String?
  // bcrypt hash — null for OAuth-only accounts (Google / magic-link)
  password      String?
  // "user" (default) or "admin"
  role          String    @default("user")
  // Personal referral code (lazy-generated on first visit to /account/refer).
  // Guests check out with no code and later link the account to past orders.
  referralCode     String? @unique
  // Store credit balance in cents, auto-applied on the user's next paid order.
  // Earned by referring a friend who completes their first purchase.
  referralCredits  Int     @default(0)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  accounts      Account[]
  sessions      Session[]
  referrals     Referral[] @relation("Referrer")
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Order {
  id                  String   @id @default(cuid())
  stripeSessionId     String   @unique
  stripePaymentIntent String?
  email               String
  imageId             String
  productType         String
  priceCents          Int?
  addWallpaper        Boolean  @default(false)
  portraitBlobUrl     String
  wallpaperBlobUrl    String?
  createdAt           DateTime @default(now())

  // Physical fulfillment (display/mounted/canvas/bundle via Prodigi)
  shippingName        String?
  shippingAddress     Json?
  printReadyBlobUrl   String?  // AI-upscaled print asset, reused on retry
  prodigiOrderId      String?  @unique
  prodigiStatus       String?  // InProgress | Complete | Cancelled | Failed
  prodigiStage        String?  // More granular: AwaitingPayment | InProgress | Shipped | etc
  trackingNumber      String?
  trackingUrl         String?
  carrier             String?
  shippedAt           DateTime?

  // Lifecycle email send-tracking. Each field is set once the corresponding
  // cron fires for this order so retries / restarts don't double-send.
  reviewEmailSentAt     DateTime?  // 7 days after purchase
  anniversaryEmailSentAt DateTime? // 365 days after purchase

  // Campaign bonus (e.g. Mother's Day free 11×14 display print). Digital-
  // only orders claim the bonus post-purchase via a separate shipping form
  // since we didn't collect shipping at checkout. Physical orders fulfill
  // the bonus at the same time as the main Prodigi order and set these
  // automatically.
  bonusClaimedAt        DateTime?
  bonusProdigiOrderId   String?  @unique
  bonusShippingName     String?
  bonusShippingAddress  Json?

  // Wallpaper → canvas ladder attribution. When a wallpaper buyer
  // upgrades to canvas (via success-page modal or one of the email
  // touches), the resulting Order carries:
  //   - upsellSource:    which touch converted them
  //                      ("wallpaper_success_modal" | "email_1h" |
  //                       "email_24h" | "email_72h")
  //   - originalOrderId: the wallpaper Order.id they upgraded from
  // Lets us measure modal vs email conversion rates cleanly and cut
  // off email reminders the moment they convert.
  upsellSource     String?
  originalOrderId  String?

  @@index([email])
  @@index([imageId])
  @@index([createdAt])
  @@index([prodigiStatus])
  @@index([originalOrderId])
}

model RateLimit {
  key     String   @id
  count   Int      @default(0)
  resetAt DateTime
}

model Subscriber {
  id             String    @id @default(cuid())
  email          String    @unique
  name           String?
  // "footer" | "exit_intent" | "abandonment" | "portrait" | "purchase" | "other"
  source         String
  subscribedAt   DateTime  @default(now())
  unsubscribedAt DateTime?
  lastEmailSent  DateTime?

  @@index([unsubscribedAt])
  @@index([source])
}

model Campaign {
  id          String    @id @default(cuid())
  subject     String
  htmlBody    String
  textBody    String?
  segment     String    @default("all") // "all" | "footer" | "exit_intent" | "abandonment" | "portrait" | "purchase"
  status      String    @default("draft") // draft | sending | sent | failed
  sentAt      DateTime?
  recipients  Int       @default(0)
  delivered   Int       @default(0)
  failed      Int       @default(0)
  createdBy   String?
  createdAt   DateTime  @default(now())
}

model EventLog {
  id        String   @id @default(cuid())
  type      String   // "error" | "warning" | "info"
  source    String   // "generate" | "webhook" | "auth" | "email" | "checkout"
  message   String
  context   Json?
  createdAt DateTime @default(now())

  @@index([createdAt])
  @@index([type])
  @@index([source])
}

model BlockedEmail {
  email     String   @id
  reason    String?
  blockedAt DateTime @default(now())
}

// Refer-a-friend tracking. One row is created when a referee completes their
// first purchase with a ref cookie present. The referrer gets referralCredits
// bumped, the referee got the ?ref= discount at checkout. Status tracks the
// lifecycle so we can retry or refund gracefully if Stripe refunds the order.
model Referral {
  id              String   @id @default(cuid())
  referrerUserId  String
  refereeEmail    String
  stripeSessionId String?  @unique
  // pending (captured at checkout-create) | completed (webhook credited the referrer)
  // | refunded (referee refunded; referrer credit claw-back TBD)
  status          String   @default("pending")
  // Dollars off the referee got, in cents.
  discountCents   Int      @default(1000)
  // Dollars credited to the referrer's balance, in cents.
  creditCents     Int      @default(1000)
  createdAt       DateTime @default(now())
  completedAt     DateTime?

  referrer User @relation("Referrer", fields: [referrerUserId], references: [id], onDelete: Cascade)

  @@index([referrerUserId])
  @@index([refereeEmail])
  @@index([status])
}

// Pinterest pin queue + audit log. Replaces the JSON files at
// docs/marketing/pinterest/queue.json + published.json so the daily
// Vercel Cron function can read/write state from a serverless context
// (the function bundle is read-only on disk).
//
// Status lifecycle: queued → published (or failed). Each cron run pulls
// the oldest N queued rows, renders + uploads them, and stamps either
// pinId+publishedAt or error+failedAt.
model PinterestPin {
  id            String    @id @default(cuid())
  // Pin number from the original brief (1-30 starters, 31-60 second batch).
  // Useful for traceability and matching back to docs/marketing/pinterest/.
  briefNumber   Int       @unique
  board         String
  seoTitle      String
  description   String
  altText       String
  // Destination URL on pawmasterpiece.com (e.g. /start?style=oil).
  link          String
  // Style key used for image generation (matches a file in public/examples/).
  style         String
  // On-pin overlay components rendered into the PNG at upload time.
  eyebrow       String
  titleA        String
  titleB        String
  tagline       String
  // "queued" | "published" | "failed"
  status        String    @default("queued")
  // Pinterest's pin ID after successful upload, used to verify status later.
  pinId         String?
  // Board ID the pin was actually posted to (matches our 8 created boards).
  boardId       String?
  publishedAt   DateTime?
  failedAt      DateTime?
  // Last error message if status=failed. Null on success.
  error         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([status])
  @@index([createdAt])
}

// Outreach pipeline — pet bloggers, influencers, podcasters, etc.
// Tracks the status of every cold pitch we send so we don't double-send and
// can see at a glance who's pending a follow-up. Seeded with the 9 pet
// blogger drafts from docs/marketing/outreach/pet-blogger-outreach.md;
// admins add new influencers (Instagram/TikTok) through /admin/outreach.
model OutreachContact {
  id             String    @id @default(cuid())
  name           String
  // "blogger" | "instagram" | "tiktok" | "podcast" | "youtube" | "other"
  channel        String
  // The publication/handle/username — DogTipper.com, @bertiethedog, etc.
  handle         String
  email          String?
  // Niche keywords: "dog mom, watercolor, gift guide" — used for DM personalization
  niche          String?
  followers      Int?
  // Reference URL — their site, IG profile, TikTok, etc.
  url            String?
  // Pre-drafted subject line for email channels; null for IG/TT (use DM)
  subject        String?
  // Pre-drafted body (markdown OK)
  body           String?
  // "pending" | "sent" | "replied" | "accepted" | "posted" | "passed" | "no_reply"
  status         String    @default("pending")
  // Tier of expected payoff: 1 (DogTipper sponsored) → 3 (cold IG nobody knows)
  priority       Int       @default(2)
  notes          String?
  sentAt         DateTime?
  repliedAt      DateTime?
  acceptedAt     DateTime?
  postedAt       DateTime?
  followUpAt     DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@index([status])
  @@index([channel])
  @@index([priority])
}

// Wallpaper → canvas ladder follow-up queue. Three rows are created the
// moment a standalone wallpaper purchase lands (upsell_1h / upsell_24h /
// upsell_72h) and /api/cron/upsell-emails delivers whichever are due.
// Converting to any wall print cancels the remaining touches so nobody
// gets nagged after buying (see lib/upsell-emails.ts).
//
// Status lifecycle: pending → sent | cancelled | failed. A transient send
// failure stays pending (retried every cron run) until the row is 48h past
// its sendAt, after which it's marked failed for admin attention.
model ScheduledEmail {
  id          String    @id @default(cuid())
  // Template key: "upsell_1h" | "upsell_24h" | "upsell_72h"
  template    String
  email       String
  // The wallpaper Order this ladder belongs to.
  orderId     String
  sendAt      DateTime
  status      String    @default("pending")
  sentAt      DateTime?
  cancelledAt DateTime?
  error       String?
  createdAt   DateTime  @default(now())

  // Idempotent scheduling under Stripe webhook retries.
  @@unique([orderId, template])
  @@index([status, sendAt])
  @@index([email])
}
