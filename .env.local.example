GEMINI_API_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_DIGITAL_PRICE_ID=
STRIPE_WALLPAPER_PRICE_ID=
STRIPE_DISPLAY_PRICE_ID=
STRIPE_MOUNTED_PRICE_ID=
STRIPE_CANVAS_PRICE_ID=
STRIPE_BUNDLE_PRICE_ID=
# ─── Expansion catalog ────────────────────────────────────────────────
# Each of the below unlocks one product tile in ProductSelector when
# set. Create a Product in Stripe, grab its Price ID, paste here.
STRIPE_CANVAS_16X20_PRICE_ID=
STRIPE_MULTIPET_PRICE_ID=
STRIPE_GALLERY_SET_PRICE_ID=
STRIPE_ACRYLIC_PRICE_ID=
STRIPE_METAL_PRICE_ID=
STRIPE_CARDS_PRICE_ID=
STRIPE_PHONE_CASE_PRICE_ID=
STRIPE_PRISM_PRICE_ID=
STRIPE_MUG_PRICE_ID=
STRIPE_PILLOW_PRICE_ID=
RESEND_API_KEY=
BLOB_READ_WRITE_TOKEN=
NEXT_PUBLIC_BASE_URL=
# Stripe customer portal login link — grab from dashboard.stripe.com/settings/billing/portal
STRIPE_BILLING_PORTAL_URL=
FROM_EMAIL=Paw Masterpiece <orders@yourdomain.com>

# Prodigi print-on-demand (display/mounted/canvas/bundle fulfillment)
# Leave blank until you have an account — the webhook will skip Prodigi
# and log a warning; you can manually submit orders from the admin page.
PRODIGI_ENV=sandbox
PRODIGI_API_KEY=
PRODIGI_DISPLAY_SKU=GLOBAL-MINI-11X14
PRODIGI_MOUNTED_SKU=GLOBAL-MOUNTED-MINI-11X14
PRODIGI_CANVAS_SKU=ECO-FRA-CAN-8X12
# Expansion — look up SKUs in the Prodigi catalog. Leave blank to hide.
PRODIGI_CANVAS_16X20_SKU=
PRODIGI_GALLERY_SET_SKU=
PRODIGI_ACRYLIC_SKU=
PRODIGI_METAL_SKU=
PRODIGI_CARDS_SKU=
PRODIGI_PHONE_CASE_SKU=
PRODIGI_PRISM_SKU=
PRODIGI_MUG_SKU=
PRODIGI_PILLOW_SKU=
PRODIGI_WEBHOOK_SECRET=

# Replicate (AI upscaler — runs only on paid orders before printing)
# Leave blank to ship the original 1024×1024 Gemini output (will look soft
# at 11×14+ print sizes). Get a token at https://replicate.com/account/api-tokens
REPLICATE_API_TOKEN=

# ─── Analytics / Ad Pixels ─────────────────────────────────────────────────
# All optional — missing IDs cause the tracking scripts to render nothing, so
# local dev stays clean. Paste real IDs when you're ready to start tracking.
#
# GA4: Admin → Data Streams → Web → Measurement ID (format: G-XXXXXXXXXX)
NEXT_PUBLIC_GA4_MEASUREMENT_ID=
# Meta Pixel: Events Manager → Data Sources → your pixel (15-digit numeric ID)
NEXT_PUBLIC_META_PIXEL_ID=
# TikTok Pixel: TikTok Ads Manager → Assets → Events → Web Events (C + 19 chars)
NEXT_PUBLIC_TIKTOK_PIXEL_ID=
# Pinterest Tag: business.pinterest.com → Ads → Conversions → Tag manager.
# Tracks page views, signups, purchases on Pinterest Ads campaigns.
NEXT_PUBLIC_PINTEREST_TAG_ID=
# Microsoft Clarity: clarity.microsoft.com → New project → copy the ID from
# the install snippet (lowercase string, ~10 chars). Free session recordings
# + heatmaps. Critical for diagnosing preview-to-purchase drop-off.
NEXT_PUBLIC_CLARITY_ID=
# Set to "true" to console.log every analytics event (useful for local testing)
NEXT_PUBLIC_ANALYTICS_DEBUG=

# ─── Server-side Conversion APIs ──────────────────────────────────────────
# Recovers 13-19% of post-iOS attribution lost by the client-side pixels.
# Fires alongside the pixel events, deduped via event_id on the platform.
#
# Meta CAPI access token: Events Manager → your pixel → Settings → Conversions
# API → Generate access token. Long string starting with "EAA...". Required
# for the server to send Purchase/Lead events to graph.facebook.com.
META_CAPI_ACCESS_TOKEN=
# Optional — only while validating in test mode. Get from Events Manager →
# Test events tab. Strip after going live or events won't show up on the
# main dashboard.
META_CAPI_TEST_CODE=
# TikTok Events API access token: TikTok Events Manager → your pixel →
# Settings → Events API → Generate Access Token.
TIKTOK_EVENTS_API_TOKEN=
# Optional — TikTok test event ID. Get from Events Manager → Test Events.
TIKTOK_EVENTS_TEST_ID=

# ─── Free shipping progress bar ────────────────────────────────────────────
# Sets the dollar threshold for the dynamic shipping bar mounted in
# StickyCartBar. Leave blank to keep the bar inert. Recommended: 75 or 79
# (forces upsell from $6 digital → $79 bundle). ALSO configure Stripe
# shipping rates to actually grant free shipping above this amount, or
# users will see "you qualify" without actually getting free shipping.
NEXT_PUBLIC_FREE_SHIPPING_THRESHOLD_USD=

# Pinterest API access token — for scripts/upload-pinterest-pins.mjs AND
# the Vercel Cron daily uploader at /api/cron/pinterest-publish.
# Get one at developers.pinterest.com → Create app → Generate access token
# with scopes: boards:read, boards:write, pins:read, pins:write. Token
# expires every ~30 days on sandbox apps; regenerate + paste in Vercel
# Environment Variables to keep the cron uploader alive past day 30.
PINTEREST_ACCESS_TOKEN=
# Override the Pinterest API base URL. Default is sandbox. Switch to
# https://api.pinterest.com/v5 once you've been approved for production.
PINTEREST_API_BASE=
# How many pins the Vercel Cron tries to publish per daily run (default 2).
# Pinterest sandbox rate-limits at ~10-20 pins/hour, so 2/day is safe.
PINTEREST_CRON_BATCH=2

# Vercel Cron auth secret. Vercel sends this in the Authorization header
# when invoking scheduled functions. Generate via: openssl rand -hex 32
# Must be the same value here AND in Vercel Environment Variables.
CRON_SECRET=
# Pinterest domain verify token — paste from pinterest.com/settings/claim.
# Required to enable rich pins (live pricing, aggregate rating) when users
# save our pages. Leave blank until you've claimed the domain.
PINTEREST_DOMAIN_VERIFY=
# Google Search Console verification — search.google.com/search-console →
# Add property → pick "HTML tag" method → copy the content="..." value
# (the token string only, not the whole <meta> tag). Deploy, click Verify.
GOOGLE_SITE_VERIFICATION=
# Bing Webmaster Tools verification — bing.com/webmasters → Add site →
# HTML meta tag method → copy the content="..." value. Also used by
# DuckDuckGo and ChatGPT's search integration.
BING_SITE_VERIFICATION=
